  m_EditorClassIdentifier: EduGallery::EduGallery.WordTilePuzzle
  puzzleId: David's material
  title: The missing word
  instructions: Read the sentence. Grab the right word and place it on the plate.
  hint: 'Look at the statue in the middle of the room: it is made of white stone.'
  solvedText: Correct! Michelangelo was 26 when he carved David (1501-1504).
  artwork: {fileID: 11400000, guid: 918be4b2790b3555bac430b67fbb2dc8, type: 2}
  statusLabel: {fileID: 145484783}
  countsForScore: 1
  sentence: Michelangelo carved the statue of David from a single block of ____.
  correctWord: marble
