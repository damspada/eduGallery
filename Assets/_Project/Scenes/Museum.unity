  m_Name: 
  m_EditorClassIdentifier: EduGallery::EduGallery.SocketMatchPuzzle
  puzzleId: Venus jigsaw
  title: The broken painting
  instructions: This painting is in pieces! Find the 6 pieces around the room and put each one in its place in the frame.
  hint: The pieces lean low against the two side walls. Venus stands on a shell in the middle of the painting.
  solvedText: The Birth of Venus is whole again! Botticelli painted it around 1485.
  artwork: {fileID: 11400000, guid: bbff2f3aac412ac308bd6bb18c74a509, type: 2}
  statusLabel: {fileID: 2129167474}
